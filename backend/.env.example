# Offline launchers default to local. Hosted services MUST use cloud.
PLANAR_MODE=cloud
PAYMENTS_MODE=disabled
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret: enter the actual URL in the provider's environment settings only.
# Use Supabase's session pooler, port 5432, with an URL-encoded password.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@POOLER:5432/postgres
CORS_ORIGINS=https://YOUR-PROJECT.vercel.app
STORAGE_PATH=/var/data/planar
OWNER_EMAIL=marcos.pacheco@cun.edu.co
